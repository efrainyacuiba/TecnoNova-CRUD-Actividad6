@* TecnoNova Bolivia — layout compartido con escenario WebGL persistente.
   REEMPLAZA Views/Shared/_Layout.cshtml. El <canvas id="tn-stage"> vive aquí y NUNCA se reemplaza:
   la navegación parcial solo sustituye el contenido de <main id="tn-main">. *@
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#020814" />
    <title>@ViewData["Title"] - TecnoNova Bolivia</title>
    <link rel="stylesheet" href="~/css/tecnonova-motion.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="tn-body">
    <canvas id="tn-stage" aria-hidden="true"></canvas>
    <div class="tn-vignette" aria-hidden="true"></div>
    <div id="tn-flash" aria-hidden="true"></div>

    <header class="tn-header">
        <a class="tn-brand" asp-controller="Interfaz" asp-action="Index" data-tn-link aria-label="TecnoNova Bolivia, inicio">
            <span class="tn-brand-mark" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#39d0ff" stroke-width="1.6"><rect x="6" y="6" width="12" height="12" rx="2"/><path d="M9 2v4M15 2v4M9 18v4M15 18v4M2 9h4M2 15h4M18 9h4M18 15h4"/></svg>
            </span>
            <span class="tn-brand-name">TecnoNova<small>BOLIVIA</small></span>
        </a>
        <nav class="tn-nav" id="tn-nav" aria-label="Principal">
            <a asp-controller="Interfaz" asp-action="Index" data-tn-link>Inicio</a>
            <a asp-controller="Interfaz" asp-action="Catalogo" data-tn-link>Catálogo</a>
            <a asp-controller="Interfaz" asp-action="Inventario" data-tn-link>Inventario</a>
            <a asp-controller="Interfaz" asp-action="Nuevo" data-tn-link>Nuevo producto</a>
            <a asp-controller="Ventas" asp-action="Create" data-tn-link style="background:#39d0ff; color:#020814; font-weight:700; border-radius:999px; padding:8px 14px;">🛒 Nueva Venta</a>
            <a asp-controller="Ventas" asp-action="Index" data-tn-link>Historial Ventas</a>
        </nav>
        <button type="button" class="tn-menu-btn" data-tn-menu aria-label="Abrir menú" aria-controls="tn-nav">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </button>
    </header>

    @* Solo este bloque se sustituye en la navegación parcial *@
    <main id="tn-main">
        @if (ViewContext.RouteData.Values["controller"]?.ToString() == "Productos")
        {
            <section class="tn-legacy">@RenderBody()</section>
        }
        else
        {
            @RenderBody()
        }
    </main>

    <script src="~/js/tecnonova-motion.js" asp-append-version="true"></script>
    <script src="~/js/tecnonova-ux.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>